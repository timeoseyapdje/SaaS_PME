# Database
DATABASE_URL="postgresql://username:password@localhost:5432/nkap_control"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_NAME="Nkap Control"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Nkap Control <noreply@nkapcontrol.com>

# Currency API (optional - for live rates)
CURRENCY_API_KEY=your-api-key-here

# getMIpay (Mobile Money payments)
GETMIPAY_BASE_URL=https://api.getmipay.com
GETMIPAY_PUBLIC_KEY=your-getmipay-public-key
GETMIPAY_PRIVATE_KEY=your-getmipay-private-key
GETMIPAY_MTN_SERVICE_ID=your-mtn-service-id
GETMIPAY_ORANGE_SERVICE_ID=your-orange-service-id

# Cron secret (for protected cron routes)
CRON_SECRET=your-cron-secret-here
